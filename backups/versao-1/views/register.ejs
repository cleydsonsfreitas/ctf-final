<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h2>Cadastrar</h2>
      <p>Crie sua conta para começar</p>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div id="errors" class="errors show">
      <ul>
        <% errors.forEach(error => { %>
        <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
    <% } else { %>
    <div id="errors" class="errors"></div>
    <% } %>

    <form id="registerForm" action="/register" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-group">
        <label for="username">Nome de Usuário</label>
        <input type="text" id="username" name="username" value="<%= old.username || '' %>" required autocomplete="username" minlength="3" maxlength="20" placeholder="usuario123">
      </div>

      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= old.email || '' %>" required autocomplete="email" placeholder="seu@email.com">
      </div>

      <div class="form-group">
        <label for="password">Senha</label>
        <div class="password-wrapper">
          <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8" placeholder="••••••••">
          <button type="button" id="togglePassword" class="toggle-password" aria-label="Mostrar/ocultar senha">👁</button>
        </div>
        <small class="form-hint">Mínimo 8 caracteres</small>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirmar Senha</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-primary btn-block">Cadastrar</button>
    </form>

    <div class="auth-footer">
      <p>Já tem conta? <a href="/login">Entrar</a></p>
    </div>
  </div>
</div>