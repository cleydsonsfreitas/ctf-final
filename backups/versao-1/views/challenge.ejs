<div class="challenge-page">
  <div class="challenge-header">
    <div class="challenge-meta">
      <span class="challenge-category"><%= challenge.category %></span>
      <span class="challenge-difficulty <%= challenge.difficulty.toLowerCase() %>"><%= challenge.difficulty %></span>
    </div>
    <h1><%= challenge.title %></h1>
    <div class="timer-container" id="timerContainer">
      <label>Tempo: </label>
      <span id="timer" data-start="<%= startTime %>">00:00</span>
    </div>
  </div>

  <div class="challenge-content">
    <div class="challenge-description">
      <h3>Descrição</h3>
      <p><%= challenge.description %></p>
    </div>

    <div class="challenge-hints">
      <h3>Dicas</h3>
      <ul>
        <% if (challenge.difficulty === 'Facil') { %>
        <li>Procure por pistas no código fonte ou console do navegador</li>
        <li>Flags seguem o formato: CTF{...}</li>
        <% } else if (challenge.difficulty === 'Normal') { %>
        <li>Teste entradas especiais nos formulários</li>
        <li>Ferramentas como Burp Suite podem ajudar</li>
        <% } else { %>
        <li>Análise profunda necessária</li>
        <li>Conhecimento avançado da categoria requerido</li>
        <% } %>
      </ul>
    </div>

    <form id="flagForm" class="flag-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="flag">Submeter Flag</label>
        <div class="flag-input-wrapper">
          <input type="text" id="flag" name="flag" placeholder="CTF{...}" required autocomplete="off" pattern="CTF\{.+\}" title="Formato: CTF{...}">
          <button type="submit" class="btn btn-primary">Enviar</button>
        </div>
        <small class="form-hint">Formato: CTF{flag_aqui}</small>
      </div>
      <div id="submitMessage" class="submit-message"></div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const timerEl = document.getElementById('timer');
    const startTime = parseInt(timerEl.dataset.start);
    
    function updateTimer() {
      const elapsed = Math.floor((Date.now() - startTime) / 1000);
      const mins = Math.floor(elapsed / 60).toString().padStart(2, '0');
      const secs = (elapsed % 60).toString().padStart(2, '0');
      timerEl.textContent = `${mins}:${secs}`;
    }
    
    setInterval(updateTimer, 1000);
    updateTimer();

    const form = document.getElementById('flagForm');
    const messageEl = document.getElementById('submitMessage');
    const submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      messageEl.textContent = '';
      messageEl.className = 'submit-message';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      const formData = new FormData(form);
      
      try {
        const response = await fetch(`/challenge/${challenge.id}/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });

        const data = await response.json();
        
        if (data.success) {
          messageEl.textContent = data.message;
          messageEl.classList.add('success');
          setTimeout(() => {
            window.location.href = data.redirect;
          }, 1500);
        } else {
          messageEl.textContent = data.message;
          messageEl.classList.add('error');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar';
        }
      } catch (err) {
        messageEl.textContent = 'Erro de conexão. Tente novamente.';
        messageEl.classList.add('error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar';
      }
    });
  });
</script>